+      }
+      const bool InWindow = (i >= From && i < To);
+      if (!InWindow) {
+        LogMan::Msg::EFmt("[ircap]   DEF %{} @{}  {}", Def, i, Lines[i]);
+      }
+      break;
+    }
+  }
