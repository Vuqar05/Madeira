+static void IosMonoTryActivate(ContextImpl* CTX, FEXCore::Core::InternalThreadState* Thread) {
+  uint64_t BlockBegin = 0, HostPC = 0, FaultAddr = 0;
+  if (!ios_fex_mono_take_pending(&BlockBegin, &HostPC, &FaultAddr)) {
+    return;
+  }
